<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:loc="clr-namespace:MauiControlsShowcase.MarkupExtensions"
             x:Class="MauiControlsShowcase.Views.DemoModalPage"
             Title="{loc:Translate Modal_Title}">

    <Grid Padding="24" RowDefinitions="*,Auto" RowSpacing="20">
        <VerticalStackLayout Grid.Row="0" Spacing="10" VerticalOptions="Center">
            <Label Text="{loc:Translate Modal_Heading}" Style="{StaticResource PageTitleLabel}" HorizontalTextAlignment="Center" />
            <Label Text="{loc:Translate Modal_Body}"
                   Style="{StaticResource PageSubtitleLabel}" HorizontalTextAlignment="Center" LineBreakMode="WordWrap" />
        </VerticalStackLayout>
        <Button Grid.Row="1" Text="{loc:Translate Modal_Close}" Clicked="OnCloseClicked" HorizontalOptions="Fill" />
    </Grid>

</ContentPage>
