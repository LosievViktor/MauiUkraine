<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:MauiControlsShowcase.ViewModels"
             xmlns:loc="clr-namespace:MauiControlsShowcase.MarkupExtensions"
             xmlns:services="clr-namespace:MauiControlsShowcase.Services"
             x:Class="MauiControlsShowcase.Views.ButtonsAndInputsPage"
             x:DataType="vm:ButtonsAndInputsViewModel"
             Title="{loc:Translate Buttons_Title}"
             AutomationProperties.AutomationId="page_buttons">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="8">

            <Label Text="{loc:Translate Buttons_Title}" Style="{StaticResource PageTitleLabel}" />
            <Label Text="{loc:Translate Buttons_Subtitle}"
                   Style="{StaticResource PageSubtitleLabel}" />

            <Label Text="Button" Style="{StaticResource SectionHeaderLabel}" />
            <Border Style="{StaticResource CardBorder}">
                <FlexLayout Wrap="Wrap" JustifyContent="Start" AlignItems="Center">
                    <Button Text="{loc:Translate Buttons_Filled}" Margin="0,0,10,10" />
                    <Button Text="{loc:Translate Buttons_Outline}" Style="{StaticResource OutlineButton}" Margin="0,0,10,10" />
                    <Button Text="{loc:Translate Buttons_Disabled}" IsEnabled="False" Margin="0,0,10,10" />
                </FlexLayout>
            </Border>

            <Label Text="Entry" Style="{StaticResource SectionHeaderLabel}" />
            <Border Style="{StaticResource CardBorder}">
                <VerticalStackLayout Spacing="10">
                    <Entry Placeholder="{loc:Translate Buttons_FullNamePlaceholder}" Text="{Binding FullName}" ClearButtonVisibility="WhileEditing" />
                    <Entry Placeholder="{loc:Translate Buttons_PasswordPlaceholder}" Text="{Binding Password}" IsPassword="True" />
                    <Entry Placeholder="{loc:Translate Buttons_NumericPlaceholder}" Keyboard="Numeric" />
                    <Label>
                        <Label.Text>
                            <MultiBinding Converter="{StaticResource FormatConverter}" ConverterParameter="Buttons_HelloFormat">
                                <Binding Path="FullName" />
                                <Binding Path="CultureVersion" Source="{x:Static services:LocalizationResourceManager.Instance}" />
                            </MultiBinding>
                        </Label.Text>
                    </Label>
                </VerticalStackLayout>
            </Border>

            <Label Text="SearchBar" Style="{StaticResource SectionHeaderLabel}" />
            <Border Style="{StaticResource CardBorder}">
                <VerticalStackLayout Spacing="8">
                    <SearchBar Placeholder="{loc:Translate Buttons_SearchPlaceholder}" Text="{Binding SearchQuery}" />
                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding SearchResults}" Spacing="4">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="x:String">
                                <Label Text="{Binding .}" Padding="8,5" BackgroundColor="{StaticResource Secondary}" />
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Border>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
