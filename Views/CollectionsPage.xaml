<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:MauiControlsShowcase.ViewModels"
             xmlns:models="clr-namespace:MauiControlsShowcase.Models"
             x:Class="MauiControlsShowcase.Views.CollectionsPage"
             x:DataType="vm:CollectionsViewModel"
             x:Name="RootPage"
             Title="Колекції">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="8">

            <Label Text="Колекції" Style="{StaticResource PageTitleLabel}" />
            <Label Text="CollectionView, SwipeView, RefreshView, CarouselView і IndicatorView — елементи списків на основі даних MAUI."
                   Style="{StaticResource PageSubtitleLabel}" />

            <Label Text="CollectionView + SwipeView + RefreshView" Style="{StaticResource SectionHeaderLabel}" />
            <Border Style="{StaticResource CardBorder}">
                <VerticalStackLayout Spacing="10">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <Entry Grid.Column="0" Placeholder="Додати нове завдання..." Text="{Binding NewTodoText}"
                               ReturnCommand="{Binding AddTodoCommand}" />
                        <Button Grid.Column="1" Text="Додати" Command="{Binding AddTodoCommand}" />
                    </Grid>

                    <Label Text="Потягніть вниз, щоб оновити · проведіть рядок ліворуч, щоб видалити" Style="{StaticResource CaptionLabel}" />

                    <RefreshView IsRefreshing="{Binding IsRefreshing}" Command="{Binding RefreshCommand}" HeightRequest="280">
                        <CollectionView ItemsSource="{Binding Todos}" SelectionMode="None">
                            <CollectionView.ItemTemplate>
                                <DataTemplate x:DataType="models:TodoItem">
                                    <SwipeView>
                                        <SwipeView.RightItems>
                                            <SwipeItems>
                                                <SwipeItem Text="Видалити"
                                                           BackgroundColor="{StaticResource Danger}"
                                                           Command="{Binding Source={x:Reference RootPage}, Path=BindingContext.DeleteTodoCommand}"
                                                           CommandParameter="{Binding .}" />
                                            </SwipeItems>
                                        </SwipeView.RightItems>
                                        <Grid Padding="4,10" ColumnDefinitions="6,Auto,*,Auto" ColumnSpacing="10">
                                            <BoxView Grid.Column="0" Color="{Binding Priority, Converter={StaticResource PriorityToColorConverter}}"
                                                     WidthRequest="6" CornerRadius="3" />
                                            <CheckBox Grid.Column="1" IsChecked="{Binding IsDone}" />
                                            <Label Grid.Column="2" Text="{Binding Title}" VerticalOptions="Center" LineBreakMode="TailTruncation"
                                                   TextDecorations="{Binding IsDone, Converter={StaticResource BoolToStrikethroughConverter}}"
                                                   Opacity="{Binding IsDone, Converter={StaticResource BoolToDoneOpacityConverter}}" />
                                            <Label Grid.Column="3" Text="{Binding Priority, Converter={StaticResource PriorityToDisplayConverter}}" Style="{StaticResource CaptionLabel}" VerticalOptions="Center" />
                                        </Grid>
                                    </SwipeView>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                            <CollectionView.EmptyView>
                                <Label Text="Завдань не залишилось — додайте нове вище!" HorizontalOptions="Center" Style="{StaticResource CaptionLabel}" Margin="0,20" />
                            </CollectionView.EmptyView>
                        </CollectionView>
                    </RefreshView>
                </VerticalStackLayout>
            </Border>

            <Label Text="CarouselView + IndicatorView + Image" Style="{StaticResource SectionHeaderLabel}" />
            <Border Style="{StaticResource CardBorder}">
                <VerticalStackLayout Spacing="8">
                    <CarouselView x:Name="Gallery" ItemsSource="{Binding GalleryPhotos}" HeightRequest="200" Loop="False"
                                  IndicatorView="{x:Reference GalleryIndicator}">
                        <CarouselView.ItemTemplate>
                            <DataTemplate x:DataType="models:GalleryPhoto">
                                <Border StrokeShape="RoundRectangle 12" Padding="0" Margin="4" StrokeThickness="0">
                                    <Grid>
                                        <Image Source="{Binding ImageUrl}" Aspect="AspectFill" HeightRequest="150" />
                                        <Label Text="{Binding Caption}" TextColor="White" BackgroundColor="#88000000"
                                               Padding="8,4" VerticalOptions="End" FontSize="12" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </CarouselView.ItemTemplate>
                    </CarouselView>
                    <IndicatorView x:Name="GalleryIndicator" IndicatorsShape="Circle"
                                   IndicatorColor="{StaticResource Gray200}"
                                   SelectedIndicatorColor="{StaticResource Primary}"
                                   HorizontalOptions="Center" />
                </VerticalStackLayout>
            </Border>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
