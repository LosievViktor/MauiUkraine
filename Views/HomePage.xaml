<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:MauiControlsShowcase.ViewModels"
             xmlns:loc="clr-namespace:MauiControlsShowcase.MarkupExtensions"
             x:Class="MauiControlsShowcase.Views.HomePage"
             x:DataType="vm:HomeViewModel"
             x:Name="RootPage"
             Title="{loc:Translate Flyout_Home}"
             AutomationProperties.AutomationId="page_home">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="12">

            <Label Text="{loc:Translate Home_HeroTitle}"
                   Style="{StaticResource PageTitleLabel}"
                   AutomationProperties.AutomationId="home_hero_title" />
            <Label Text="{loc:Translate Home_HeroSubtitle}"
                   Style="{StaticResource PageSubtitleLabel}"
                   AutomationProperties.AutomationId="home_hero_subtitle" />

            <Label Text="{loc:Translate Language_Label}"
                   Style="{StaticResource SectionHeaderLabel}" />
            <HorizontalStackLayout Spacing="16"
                                   RadioButtonGroup.GroupName="languageGroup"
                                   RadioButtonGroup.SelectedValue="{Binding SelectedLanguageCode}"
                                   AutomationProperties.AutomationId="home_language_picker">
                <RadioButton Content="{loc:Translate Language_English}"
                             Value="en"
                             AutomationProperties.AutomationId="home_language_en" />
                <RadioButton Content="{loc:Translate Language_Ukrainian}"
                             Value="uk"
                             AutomationProperties.AutomationId="home_language_uk" />
            </HorizontalStackLayout>

            <Button Text="{loc:Translate Home_AboutButton}"
                    Style="{StaticResource OutlineButton}"
                    Command="{Binding OpenRepoInfoCommand}"
                    HorizontalOptions="Start"
                    AutomationProperties.AutomationId="home_about_button" />

            <Label Text="{loc:Translate Home_MenuSection}"
                   Style="{StaticResource SectionHeaderLabel}"
                   Margin="0,8,0,0"
                   AutomationProperties.AutomationId="home_menu_section" />

            <!-- Filled from code-behind so items always show (WinUI CollectionView/BindableLayout quirks). -->
            <VerticalStackLayout x:Name="MenuHost"
                                 Spacing="12"
                                 AutomationProperties.AutomationId="home_features" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
