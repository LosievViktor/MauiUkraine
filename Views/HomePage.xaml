<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:MauiControlsShowcase.ViewModels"
             xmlns:models="clr-namespace:MauiControlsShowcase.Models"
             xmlns:loc="clr-namespace:MauiControlsShowcase.MarkupExtensions"
             x:Class="MauiControlsShowcase.Views.HomePage"
             x:DataType="vm:HomeViewModel"
             x:Name="RootPage"
             Title="{loc:Translate Flyout_Home}"
             AutomationProperties.AutomationId="page_home">

    <CollectionView ItemsSource="{Binding Features}" SelectionMode="None" Margin="20"
                    AutomationProperties.AutomationId="home_features">
        <CollectionView.Header>
            <VerticalStackLayout Spacing="6" Margin="0,0,0,16">
                <Label Text="{loc:Translate Home_HeroTitle}"
                       Style="{StaticResource PageTitleLabel}"
                       AutomationProperties.AutomationId="home_hero_title" />
                <Label Text="{loc:Translate Home_HeroSubtitle}"
                       Style="{StaticResource PageSubtitleLabel}"
                       AutomationProperties.AutomationId="home_hero_subtitle" />

                <Label Text="{loc:Translate Language_Label}"
                       Style="{StaticResource SectionHeaderLabel}"
                       Margin="0,10,0,0" />
                <HorizontalStackLayout Spacing="16"
                                       RadioButtonGroup.GroupName="languageGroup"
                                       RadioButtonGroup.SelectedValue="{Binding SelectedLanguageCode}"
                                       AutomationProperties.AutomationId="home_language_picker">
                    <RadioButton Content="{loc:Translate Language_English}"
                                 Value="en"
                                 AutomationProperties.AutomationId="home_language_en" />
                    <RadioButton Content="{loc:Translate Language_Ukrainian}"
                                 Value="uk"
                                 AutomationProperties.AutomationId="home_language_uk" />
                </HorizontalStackLayout>

                <Button Text="{loc:Translate Home_AboutButton}"
                        Style="{StaticResource OutlineButton}"
                        Command="{Binding OpenRepoInfoCommand}"
                        HorizontalOptions="Start"
                        Margin="0,10,0,0"
                        AutomationProperties.AutomationId="home_about_button" />
            </VerticalStackLayout>
        </CollectionView.Header>

        <CollectionView.ItemsLayout>
            <GridItemsLayout Orientation="Vertical" Span="2" VerticalItemSpacing="12" HorizontalItemSpacing="12" />
        </CollectionView.ItemsLayout>

        <CollectionView.ItemTemplate>
            <DataTemplate x:DataType="models:HomeFeature">
                <Border Style="{StaticResource CardBorder}"
                        AutomationProperties.AutomationId="{Binding Route, StringFormat='feature_{0}'}">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding Source={x:Reference RootPage}, Path=BindingContext.NavigateCommand}"
                                               CommandParameter="{Binding .}" />
                    </Border.GestureRecognizers>
                    <VerticalStackLayout Spacing="4">
                        <Label Text="{Binding Title}" FontAttributes="Bold" FontSize="15" />
                        <Label Text="{Binding Description}" Style="{StaticResource CaptionLabel}" LineBreakMode="WordWrap" />
                    </VerticalStackLayout>
                </Border>
            </DataTemplate>
        </CollectionView.ItemTemplate>
    </CollectionView>

</ContentPage>
