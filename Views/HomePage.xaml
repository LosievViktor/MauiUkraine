<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:MauiControlsShowcase.ViewModels"
             xmlns:models="clr-namespace:MauiControlsShowcase.Models"
             x:Class="MauiControlsShowcase.Views.HomePage"
             x:DataType="vm:HomeViewModel"
             x:Name="RootPage"
             Title="Головна">

    <!--
        The header (title/intro/button) lives in CollectionView.Header instead of
        wrapping the CollectionView in its own ScrollView - nesting a CollectionView
        inside another scrollable container is a common MAUI pitfall since the
        CollectionView then has no bounded height to measure against. Letting the
        CollectionView own the one scroll viewport keeps everything - header and
        grid of cards alike - scrolling together, smoothly, on every platform.
    -->
    <CollectionView ItemsSource="{Binding Features}" SelectionMode="None" Margin="20">
        <CollectionView.Header>
            <VerticalStackLayout Spacing="6" Margin="0,0,0,16">
                <Label Text="🧩 Вітрина елементів MAUI" Style="{StaticResource PageTitleLabel}" />
                <Label Text="Усі основні елементи інтерфейсу .NET MAUI в одному зручному огляді. Оберіть категорію нижче або скористайтеся бічним меню (проведіть від лівого краю або натисніть ☰)."
                       Style="{StaticResource PageSubtitleLabel}" />
                <Button Text="ℹ️ Про цей приклад"
                        Style="{StaticResource OutlineButton}"
                        Command="{Binding OpenRepoInfoCommand}"
                        HorizontalOptions="Start"
                        Margin="0,10,0,0" />
            </VerticalStackLayout>
        </CollectionView.Header>

        <CollectionView.ItemsLayout>
            <GridItemsLayout Orientation="Vertical" Span="2" VerticalItemSpacing="12" HorizontalItemSpacing="12" />
        </CollectionView.ItemsLayout>

        <CollectionView.ItemTemplate>
            <DataTemplate x:DataType="models:HomeFeature">
                <Border Style="{StaticResource CardBorder}">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding Source={x:Reference RootPage}, Path=BindingContext.NavigateCommand}"
                                               CommandParameter="{Binding .}" />
                    </Border.GestureRecognizers>
                    <VerticalStackLayout Spacing="4">
                        <Label Text="{Binding Icon}" FontSize="28" />
                        <Label Text="{Binding Title}" FontAttributes="Bold" FontSize="15" />
                        <Label Text="{Binding Description}" Style="{StaticResource CaptionLabel}" LineBreakMode="WordWrap" />
                    </VerticalStackLayout>
                </Border>
            </DataTemplate>
        </CollectionView.ItemTemplate>
    </CollectionView>

</ContentPage>
