<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:MauiControlsShowcase.ViewModels"
             xmlns:loc="clr-namespace:MauiControlsShowcase.MarkupExtensions"
             xmlns:services="clr-namespace:MauiControlsShowcase.Services"
             x:Class="MauiControlsShowcase.Views.IndicatorsAndProgressPage"
             x:DataType="vm:IndicatorsAndProgressViewModel"
             Title="{loc:Translate Indicators_Title}">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="8">

            <Label Text="{loc:Translate Indicators_Title}" Style="{StaticResource PageTitleLabel}" />
            <Label Text="{loc:Translate Indicators_Subtitle}"
                   Style="{StaticResource PageSubtitleLabel}" />

            <Label Text="ActivityIndicator" Style="{StaticResource SectionHeaderLabel}" />
            <Border Style="{StaticResource CardBorder}">
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                    <ActivityIndicator Grid.Column="0" IsRunning="{Binding IsActivityRunning}" />
                    <Label Grid.Column="1" Text="{loc:Translate Indicators_Enable}" VerticalOptions="Center" />
                    <Switch Grid.Column="2" IsToggled="{Binding IsActivityRunning}" />
                </Grid>
            </Border>

            <Label Text="ProgressBar" Style="{StaticResource SectionHeaderLabel}" />
            <Border Style="{StaticResource CardBorder}">
                <VerticalStackLayout Spacing="10">
                    <ProgressBar Progress="{Binding Progress}" />
                    <Label Style="{StaticResource CaptionLabel}">
                        <Label.Text>
                            <MultiBinding Converter="{StaticResource FormatConverter}" ConverterParameter="Indicators_ProgressFormat">
                                <Binding Path="Progress" />
                                <Binding Path="CultureVersion" Source="{x:Static services:LocalizationResourceManager.Instance}" />
                            </MultiBinding>
                        </Label.Text>
                    </Label>
                    <Button Text="{loc:Translate Indicators_Simulate}" Command="{Binding StartUploadCommand}" HorizontalOptions="Start" />
                </VerticalStackLayout>
            </Border>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
